# Copy to .env. The npm CDK commands load .env automatically.
# Direct AWS access keys; AWS CLI installation is not required.
# Create these for an IAM user in AWS Console > IAM > Users > your user >
# Security credentials > Access keys > Create access key.
# Replace the placeholders in your private .env, never in this example file.
AWS_ACCESS_KEY_ID=replace-with-your-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-your-secret-access-key

# Uncomment only if using temporary credentials.
# AWS_SESSION_TOKEN=replace-with-your-temporary-session-token

# Keep CLI operations aligned with the stack's fixed Mumbai region.
# Changing these values does not change the region in bin/lifebot.ts.
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1

# Alternative: comment out the access keys above and use an existing profile.
# AWS_PROFILE=lifebot

# Your public IPv4 address with /32. Replace this documentation example.
# npm run deploy and npm run diff pass it as the SshAllowedCidr parameter.
SSH_ALLOWED_CIDR=203.0.113.10/32

# Used by npm run setup:instance on your laptop, after CDK deployment.
# Use the PublicIpAddress output. This key stays on your laptop.
LIGHTSAIL_HOST=replace-with-instance-public-ip
LIGHTSAIL_SSH_USER=ubuntu
LIGHTSAIL_SSH_KEY=~/Downloads/LightsailDefaultKey-ap-south-1.pem

# Hermes uses ChatGPT subscription OAuth through its model wizard.
# No OPENAI_API_KEY is required here. Run npm run setup:instance -- --configure.

# Other instance settings remain CDK parameters.
# Defaults: Ubuntu 24.04, small_3_1, instance name lifebot.
